NODE_ENV=development
API_PORT=3000
WEB_PORT=4200
POSTGRES_PORT=5432
REDIS_PORT=6379
# Leave empty on a fresh installation. Set only to verified restored volumes
# when migrating an existing local database (docs/architecture/INFRASTRUCTURE.md).
POSTGRES_VOLUME=
REDIS_VOLUME=
STORAGE_VOLUMES_EXTERNAL=false
DATABASE_URL=postgresql://littora:littora@postgres:5432/littora
REDIS_URL=redis://redis:6379
PUBLIC_API_URL=http://localhost:3000/api
WEATHER_PROVIDER=openmeteo
# Server only. Optional application key subscribed to the Bulletin Vigilance API.
# Independent of WEATHER_PROVIDER; empty disables official waves/submersion alerts.
METEOFRANCE_API_KEY=
# SHOM RAM and VMAX use open data. Paid prediction APIs are not enabled.
# Explicit operator-triggered annual Ministry release; enable on both API and worker.
ARS_IMPORT_ENABLED=false
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
JWT_SECRET=change-me-before-production
# Server-only token, at least 32 non-whitespace characters. Empty disables internal routes.
ADMIN_API_TOKEN=
# Server-only HMAC key (32+ characters) for short-lived anti-abuse network hashes.
# Empty disables anonymous contribution sessions. Never expose to the web app.
REPORT_IP_HASH_KEY=
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
DOMAIN=localhost
