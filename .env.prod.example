# Private production configuration. Required blanks deliberately prevent startup.
DOMAIN=
POSTGRES_USER=littora
POSTGRES_DB=littora
# Use a unique random hexadecimal password (32 bytes or more).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379
NODE_ENV=production
WEATHER_PROVIDER=openmeteo
METEOFRANCE_API_KEY=
ARS_IMPORT_ENABLED=false
ADMIN_API_TOKEN=
REPORT_IP_HASH_KEY=
# For an existing installation, select only verified restored volumes.
POSTGRES_VOLUME=
REDIS_VOLUME=
STORAGE_VOLUMES_EXTERNAL=false
