{
  "name": "littora-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.3 <25",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "test": "npm run build && node --test test/*.test.cjs",
    "test:integration": "npm run build && node --test --test-concurrency=1 test/integration/*.test.cjs",
    "db:status": "node scripts/database.cjs status",
    "db:migrate": "node scripts/database.cjs migrate",
    "db:seed": "node scripts/database.cjs seed",
    "db:seed:demo": "node scripts/database.cjs seed-demo",
    "start:dev": "node --watch --require ts-node/register src/main.ts",
    "start:prod": "node dist/main.js",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1",
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.10",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/schedule": "6.1.3",
    "bcryptjs": "3.0.3",
    "bullmq": "5.77.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "csv-parse": "7.0.3",
    "ioredis": "5.11.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.10",
    "@types/express": "5.0.6",
    "@types/node": "25.9.1",
    "@types/pg": "8.20.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
