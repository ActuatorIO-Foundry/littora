-- Reference geometry: OpenStreetMap contributors, ODbL 1.0.
-- https://www.openstreetmap.org/relation/2202162
-- Generated by scripts/prepare-territory.cjs; do not edit an applied migration.
CREATE TABLE public.catalogue_territory_sources (
  id text PRIMARY KEY,
  source_url text NOT NULL,
  license_url text NOT NULL,
  retrieved_on date NOT NULL,
  source_sha256 text NOT NULL CHECK (source_sha256 ~ '^[a-f0-9]{64}$')
);
INSERT INTO public.catalogue_territory_sources VALUES (
  'fr-metropolitan-osm-2026-11-17',
  'https://www.openstreetmap.org/relation/2202162',
  'https://opendatacommons.org/licenses/odbl/1-0/',
  '2026-11-17', '@SOURCE_SHA256@'
);
CREATE TABLE public.catalogue_territory_parts (
  id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  source_id text NOT NULL REFERENCES public.catalogue_territory_sources(id),
  geom geometry(Polygon,4326) NOT NULL CHECK (ST_IsValid(geom) AND NOT ST_IsEmpty(geom))
);
INSERT INTO public.catalogue_territory_parts(source_id,geom)
SELECT 'fr-metropolitan-osm-2026-11-17', ST_Subdivide(ST_SetSRID(ST_GeomFromGeoJSON(
  '@GEOMETRY@'
),4326),256);
CREATE INDEX catalogue_territory_parts_geom_idx ON public.catalogue_territory_parts USING gist(geom);
ANALYZE public.catalogue_territory_parts;

CREATE FUNCTION public.catalogue_in_metropolitan_france(lat double precision,lon double precision)
RETURNS boolean LANGUAGE sql STABLE PARALLEL SAFE AS $function$
  SELECT lat BETWEEN -90 AND 90 AND lon BETWEEN -180 AND 180 AND EXISTS (
    SELECT 1 FROM public.catalogue_territory_parts r
    WHERE ST_Covers(r.geom,ST_SetSRID(ST_MakePoint(lon,lat),4326))
  );
$function$;

-- Retain every historical row. Public selection happens before paging/ranking.
ALTER VIEW public.beach_catalogue RENAME TO beach_catalogue_unfiltered;
CREATE VIEW public.beach_catalogue AS
SELECT * FROM public.beach_catalogue_unfiltered b
WHERE public.catalogue_in_metropolitan_france(b.lat,b.lon);

CREATE VIEW public.beach_territory_review AS
SELECT b.id,b.name,b.city,b.lat,b.lon,
  public.catalogue_in_metropolitan_france(b.lat,b.lon) AS included,
  'fr-metropolitan-osm-2026-11-17'::text AS reference_id
FROM public.beaches b;
