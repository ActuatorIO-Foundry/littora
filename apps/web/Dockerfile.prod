FROM node:24.22.3-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS build
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json
RUN npm ci --workspace apps/web --workspace packages/api-client --no-audit --no-fund
COPY apps/web ./apps/web
COPY packages/api-client ./packages/api-client
RUN npm run build --workspace apps/web
FROM nginx:1.31.8-alpine@sha256:fed7e14be83cbd2661a75cdc5b872d936cf155d46c327084d30b8df19ae88d72
RUN apk add --no-cache --upgrade zlib=1.4-r0 libxslt=1.1.43-r4
COPY --from=build /app/apps/web/dist/littora-web/browser /usr/share/nginx/html
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY infra/diagnostics/daemon.sh /usr/local/bin/littora-daemon
ENTRYPOINT ["/bin/sh", "/usr/local/bin/littora-daemon"]
CMD ["nginx","-g","daemon off;"]
