FROM node:24.22.3-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS build
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build
FROM nginx:1.31.8-alpine@sha256:fed7e14be83cbd2661a75cdc5b872d936cf155d46c327084d30b8df19ae88d72
RUN apk add --no-cache --upgrade zlib=1.4-r0 libxslt=1.1.43-r4
COPY --from=build /app/dist/littora-web/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
