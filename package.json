{
  "name": "littora-platform",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24.22.3 <25", "npm": "11.19.1" },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "audit": "npm --prefix apps/api audit --audit-level=low && npm --prefix apps/web audit --audit-level=low",
    "install:ci": "npm --prefix apps/api ci && npm --prefix apps/web ci",
    "test:api": "npm --prefix apps/api test",
    "test:integration": "npm --prefix apps/api run test:integration",
    "test:ui": "npm --prefix apps/web run test:ui",
    "docker:local": "docker compose -f docker-compose.local.yml up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build"
  }
}
